# Allowed email domains (comma-separated)
ALLOWED_DOMAINS=example.com,yourcompany.no

# Clojure backend API configuration
RAG_API_URL=http://localhost:8080
RAG_API_KEY=rag_your_api_key_here

# Explicit request-time config node selectors for config helper endpoints
# Format: <tenant>/<root>/<node-slug>
# Example:
# RAG_PLATFORM_CONFIG=digdir/platform/default
# RAG_RUNTIME_CONFIG=digdir/runtime/default
# RAG_DATASET_CONFIG=digdir/dataset/default
RAG_PLATFORM_CONFIG=
RAG_RUNTIME_CONFIG=
RAG_DATASET_CONFIG=

# Optional fixed public selectors for proxied `/api/rag` and `/api/retrieve` requests
# Public API requests are dataset-first and use config keys rather than legacy pipeline selectors.
RAG_PUBLIC_TENANT=
RAG_PUBLIC_DATASET_CONFIG_KEY=
RAG_PUBLIC_RUNTIME_CONFIG_KEY=
RAG_PUBLIC_AGENT_ID=

# Session configuration
SESSION_SECRET=generate-a-random-secret-here

# Server configuration
PORT=5173
NODE_ENV=development
LOG_LEVEL=debug

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated list of allowed frontend origins
# The Slack flow returns the user to the frontend origin that started the login flow.
# FRONTEND_URLS=http://localhost:3000,https://your-tunnel.example.com

# Slack OpenID Connect (optional)
# Create an app at https://api.slack.com/apps and enable "Sign in with Slack"
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5173/auth/slack/callback
# Optional: restrict login to one Slack workspace
SLACK_TEAM_ID=
