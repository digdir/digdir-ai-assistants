# Allowed email domains (comma-separated)
ALLOWED_DOMAINS=example.com,yourcompany.no

# Clojure backend API configuration
RAG_API_URL=http://localhost:8080
RAG_API_KEY=rag_your_api_key_here

# Session configuration
SESSION_SECRET=generate-a-random-secret-here

# Server configuration
PORT=5173
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated list of allowed frontend origins
# The Slack flow returns the user to the frontend origin that started the login flow.
# FRONTEND_URLS=http://localhost:3000,https://your-tunnel.example.com

# Slack OpenID Connect (optional)
# Create an app at https://api.slack.com/apps and enable "Sign in with Slack"
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5173/auth/slack/callback
# Optional: restrict login to one Slack workspace
SLACK_TEAM_ID=
